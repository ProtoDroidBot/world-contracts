# ============================================
# SUI NETWORK CONFIGURATION
# ============================================
SUI_NETWORK=localnet

# Custom RPC URL (optional, defaults to public endpoints)
# SUI_RPC_URL=https://fullnode.devnet.sui.io:443
# For localnet in Docker, use: http://host.docker.internal:9000 (Mac/Windows)
# For localnet in Docker on Linux, use: http://172.17.0.1:9000 (or your host IP)

# Deployment configuration
GOVERNOR_PRIVATE_KEY=

# Comma-separated list of admin account addresses
# Must be valid Sui addresses (64 hex chars, e.g., 0x202d7d52ab5f8e8824e3e8066c0b7458f84e326c5d77b30254c69d807586a7b0,0x202d7d52ab5f8e8824e3e8066c0b7458f84e326c5d77b30254c69d807586a7b0)
ADMIN_ADDRESS=
# Comma-separated list of sponsor addresses (each can call admin-gated entry points)
SPONSOR_ADDRESSES=


# ============================================
# TYPESCRIPT EXAMPLES CONFIGURATION
# ============================================
# Required for running TypeScript examples
# Private keys
ADMIN_PRIVATE_KEY=
PLAYER_A_PRIVATE_KEY=
PLAYER_B_PRIVATE_KEY=

# Tenant
TENANT=dev

# Fuel Configuration
FUEL_TYPE_IDS=78437,78515,78516,84868,88319,88335
FUEL_EFFICIENCIES=90,80,40,40,15,10

# Energy Configuration
# One build-scoped manifest replaces the two parallel legacy arrays.
ASSEMBLY_ENERGY_CONFIG_PATH=config/assembly-energy.json


# Package ID
WORLD_PACKAGE_ID=
BUILDER_PACKAGE_ID=

# Independently published feature packages and their shared registries.
NPC_PACKAGE_ID=
NPC_TYPE_ORIGIN=
NPC_REGISTRY_ID=
CATAPULT_PACKAGE_ID=
CATAPULT_TYPE_ORIGIN=
CATAPULT_REGISTRY_ID=
SMART_INDUSTRY_PACKAGE_ID=
SMART_INDUSTRY_TYPE_ORIGIN=
SMART_INDUSTRY_REGISTRY_ID=
TRANSPONDER_PACKAGE_ID=
TRANSPONDER_TYPE_ORIGIN=
TRANSPONDER_REGISTRY_ID=
ASSEMBLY_ACCESS_PACKAGE_ID=
ASSEMBLY_ACCESS_TYPE_ORIGIN=
ASSEMBLY_ACCESS_REGISTRY_ID=

# Gate Configuration
# Client build 3502403: Mini/Small Gate (88086) and Slingshot/Smart Catapult
# (95627) = 65 ly; Heavy Gate (84955) and Heavy Slingshot/Smart Catapult
# (95677) = 365 ly.
# MAX_DISTANCES uses exact meters: light-years * 9460730472580800.
GATE_TYPE_IDS=88086,84955,95627,95677
MAX_DISTANCES=614947480717752000,3453166622491992000,614947480717752000,3453166622491992000
